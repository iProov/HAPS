{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haps:schema:provider-certification:v0.4",
  "title": "HAPS Provider Certification Credential Claims v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providerId",
    "certifiedLevels",
    "certifiedFactors",
    "issuer",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "providerId": {
      "type": "string",
      "minLength": 3
    },
    "providerName": {
      "type": "string"
    },
    "certifiedLevels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "HAPS-PoHP-1",
          "HAPS-PoHP-2",
          "HAPS-PoHP-3",
          "HAPS-PoHP-4"
        ]
      }
    },
    "certifiedFactors": {
      "type": "array",
      "minItems": 1,
      "description": "assurance.method values this provider is certified to deliver, per factors-v0.1.md. Extensible: a verifier MUST treat an unrecognised value as uncertified for policy purposes.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issuer": {
      "type": "string",
      "minLength": 3
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "lab": {
          "type": "string"
        },
        "reportId": {
          "type": "string"
        },
        "reportUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
