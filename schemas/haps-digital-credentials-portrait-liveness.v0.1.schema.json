{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haps:schema:digital-credentials-portrait-liveness:v0.1",
  "title": "HAPS Digital Credentials Portrait/Liveness Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "profile",
    "mode",
    "binding",
    "credential_presentation"
  ],
  "properties": {
    "type": {
      "const": "digital_credentials_portrait_liveness_evidence"
    },
    "profile": {
      "const": "haps.profile.digital-credentials-portrait-liveness/v0.1"
    },
    "mode": {
      "enum": [
        "plain_digital_credentials",
        "independent_liveness",
        "trusted_liveness_issuer"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "approval_session_id",
        "audience",
        "issued_at"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "minLength": 8
        },
        "approval_session_id": {
          "type": "string",
          "minLength": 8
        },
        "journey_id": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "minLength": 3
        },
        "action_hash": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{16,}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "credential_presentation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "protocol",
        "presentation_hash",
        "issuer"
      ],
      "properties": {
        "source": {
          "enum": [
            "apple_wallet",
            "digital_credentials_api",
            "eudi_wallet",
            "mdoc",
            "openid4vp",
            "other"
          ]
        },
        "protocol": {
          "type": "string",
          "minLength": 3
        },
        "presentation_ref": {
          "type": "string"
        },
        "presentation_hash": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{16,}$"
        },
        "issuer": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            },
            "trust_anchor": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "holder_auth": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string"
            },
            "result": {
              "enum": [
                "verified",
                "not_verified",
                "unknown"
              ]
            }
          },
          "additionalProperties": true
        },
        "portrait_hash": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{16,}$"
        },
        "raw_portrait": {
          "type": "string"
        },
        "raw_biometric": {
          "type": "string"
        },
        "biometric_template": {
          "type": "string"
        }
      }
    },
    "liveness": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": {
          "type": "string"
        },
        "issuer": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "attestation_ref": {
          "type": "string"
        },
        "attestation_hash": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{16,}$"
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "not_required"
          ]
        },
        "portrait_match": {
          "enum": [
            "passed",
            "failed",
            "not_required"
          ]
        },
        "assurance_level": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "raw_biometric": {
          "type": "string"
        },
        "biometric_template": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "credential_presentation"
        ],
        "properties": {
          "credential_presentation": {
            "required": [
              "raw_portrait"
            ]
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "credential_presentation"
        ],
        "properties": {
          "credential_presentation": {
            "required": [
              "raw_biometric"
            ]
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "credential_presentation"
        ],
        "properties": {
          "credential_presentation": {
            "required": [
              "biometric_template"
            ]
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "liveness"
        ],
        "properties": {
          "liveness": {
            "required": [
              "raw_biometric"
            ]
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "liveness"
        ],
        "properties": {
          "liveness": {
            "required": [
              "biometric_template"
            ]
          }
        }
      }
    }
  ]
}