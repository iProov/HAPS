/*
  HAPS v0.4.0 Challenge Mode: experimental holder co-signature variant.

  This draft specification and partial reference implementation are not
  production-ready. Model results do not establish full protocol conformance
  or that a person saw and approved the correct action.

  Models selected message-flow constraints from
  specification/draft/haps-v0.4.0.md sections 10 and 12 (paths from repo root).
  The Dolev-Yao attacker controls network inputs and outputs. Signing, hashing,
  and view/1 are symbolic abstractions, not implementations.

  HumanApproved is a rule event triggered by an attacker-supplied SHOW input.
  It requires no faithful rendering, physical presence, comprehension, or real
  approval gesture. Accept is also an event, not action execution.
  See formal/tamarin/README.md for exact formulas, assumptions, and results.
*/

theory HAPS_CoSignedApproval
begin

builtins: signing, hashing

functions: view/1   // public free constructor; no projection or rendering code

/* ------------------------------------------------------------------ setup */

// A Presence Provider registers a signing key.
rule PP_Register:
    [ Fr(~ltk) ]
  --[ PPRegistered($PP) ]->
    [ !Ltk($PP, ~ltk), !Pk($PP, pk(~ltk)), Out(pk(~ltk)) ]

// Register an abstract holder key whose public key is available to the RP.
// Enrollment, account binding, passkey APIs, and recovery are not modelled.
rule Human_Enrol:
    [ Fr(~hk) ]
  --[ HumanEnrolled($H) ]->
    [ !HLtk($H, ~hk), !HPk($H, pk(~hk)), Out(pk(~hk)) ]

rule Human_Key_Compromise:
    [ !HLtk($H, hk) ]
  --[ HumanKeyCompromised($H) ]->
    [ Out(hk) ]

// A relying party learns which provider key it trusts.
rule RP_Trusts_PP:
    [ !Pk($PP, pkPP) ]
  --[ Trusts($RP, $PP) ]->
    [ !RPTrusts($RP, $PP, pkPP) ]

// Expose a provider key to the network attacker. Some lemmas exclude this
// event anywhere in the entire trace; read each formula's condition.
rule PP_Compromise:
    [ !Ltk($PP, ltk) ]
  --[ Compromised($PP) ]->
    [ Out(ltk) ]

/* -------------------------------------------------- the protocol itself */

// Create a fresh challenge for a symbolic intent. Linear RP_Outstanding models
// single consumption; there is no expiry, database transaction, or execution.
rule RP_Issue_Challenge:
    [ Fr(~cid), In(intent) ]
  --[ ChallengeIssued($RP, ~cid, intent) ]->
    [ Out(<'HAPS_CHAL', $RP, ~cid, intent>)
    , RP_Outstanding($RP, ~cid, intent) ]

// Emit a symbolic SHOW message and Showed event. This rule has no display,
// rendering, trusted channel, or human observer.
rule PP_Show:
    [ In(<'HAPS_CHAL', rp, cid, intent>) ]
  --[ Showed($PP, cid, view(intent)) ]->
    [ Out(<'SHOW', $PP, cid, view(intent)>)
    , PP_Pending($PP, rp, cid, intent) ]

// A network SHOW input triggers HumanApproved and creates a linear Approval.
// The attacker can supply this input; the rule requires no preceding Showed
// event, actual display, presence, understanding, or user gesture.
// The stored holder key signs the input terms; no authenticator UI is modelled.
rule Human_Approve:
    let hsig = sign(<'HAPS_APPROVAL', $H, pp, cid, v>, hk)
    in
    [ In(<'SHOW', pp, cid, v>), !HLtk($H, hk) ]
  --[ HumanApproved($H, pp, cid, v) ]->
    [ Approval($H, pp, cid, v), Out(hsig) ]

// Consume a symbolic Approval and sign selected intent/view terms, audience,
// and challenge. This is not a full credential issuer.
rule PP_Issue_CC:
    let cc  = <'HAPS_CC', $PP, $H, rp, cid, h(intent), h(view(intent))>
        sig = sign(cc, ltk)
    in
    [ PP_Pending($PP, rp, cid, intent)
    , Approval($H, $PP, cid, view(intent))
    , !Ltk($PP, ltk) ]
  --[ Issued($PP, $H, rp, cid, intent) ]->
    [ Out(<cc, sig>) ]

// Match symbolic trust, audience, intent/view hashes, and a valid signature;
// consume the challenge. This is only a subset of RP requirements.
rule RP_Verify_Accept:
    let cc  = <'HAPS_CC', pp, h, $RP, cid, h(intent), h(view(intent))>
        apr = <'HAPS_APPROVAL', h, pp, cid, view(intent)>
    in
    [ RP_Outstanding($RP, cid, intent)
    , !RPTrusts($RP, pp, pkPP)
    , !HPk(h, pkH)
    , In(<cc, sig, hsig>) ]
  --[ Accept($RP, pp, h, cid, intent)
    , Verified(verify(sig, cc, pkPP))
    , Verified(verify(hsig, apr, pkH)) ]->
    [ ]

restriction signature_must_verify:
  "All x #i. Verified(x) @ i ==> x = true"

/* ----------------------------------------------------------- properties */

/*
  Seek an Accept trace without provider or holder compromise. This checks
  reachability of the abstract co-signed flow only.
*/
lemma executable:
  exists-trace
  "Ex rp pp h cid intent #i.
     Accept(rp, pp, h, cid, intent) @ i
     & not (Ex p #r. Compromised(p) @ r)
     & not (Ex hh #r. HumanKeyCompromised(hh) @ r)"

/*
  Query: Accept has an earlier matching HumanApproved event if the holder key
  is uncompromised throughout the trace; provider compromise is allowed. This
  remains a symbolic event relationship, not human approval evidence.
*/
lemma action_binding_survives_provider_compromise:
  all-traces
  "All rp pp h cid intent #i.
     Accept(rp, pp, h, cid, intent) @ i
     & not (Ex #r. HumanKeyCompromised(h) @ r)
     ==> (Ex #j. HumanApproved(h, pp, cid, view(intent)) @ j & #j < #i)"

/*
  Seek acceptance without a matching HumanApproved event in a trace with
  holder compromise. Provider compromise is NOT excluded; a witness does not
  establish that holder compromise alone is sufficient.
*/
lemma holder_key_compromise_forges:
  exists-trace
  "Ex rp pp h cid intent #i #r.
     Accept(rp, pp, h, cid, intent) @ i
     & HumanKeyCompromised(h) @ r
     & not (Ex hh #j. HumanApproved(hh, pp, cid, view(intent)) @ j)"

/*
  Query: Accept events sharing provider, holder, and challenge have the same
  position when an associated HumanApproved event exists. Neither key
  compromise is excluded; real replay-cache behavior remains out of scope.
*/
lemma no_approval_reuse:
  all-traces
  "All pp h cid v rp1 rp2 i1 i2 #a #x #y.
     HumanApproved(h, pp, cid, v) @ a
     & Accept(rp1, pp, h, cid, i1) @ x
     & Accept(rp2, pp, h, cid, i2) @ y
     ==> #x = #y"

end
